DATABASE_URL=postgres://apit:apit@localhost:5433/ap_it
# At least 32 random characters: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3200
# To let colleagues sign in from other computers on your network, add the address they open,
# comma separated (run `npm run build` then `npm run start`, not `npm run dev`):
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.25:3200
# Where uploaded files (invoices, contracts, ID photos) are kept. Defaults to an "uploads" folder
# beside the app. Include this folder in backups, with the database.
# UPLOADS_DIR=D:\AP-IT-Files
# Where `npm run backup` saves backups, and how many to keep (the newest). Best on another drive,
# or a network share, so a backup outlives this computer's disk.
# BACKUP_DIR=D:\AP-IT-Backups
# BACKUP_KEEP=14
